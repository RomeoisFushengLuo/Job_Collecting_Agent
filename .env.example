# ============================================================
# 本地测试用的环境变量示例。
#
# 用法：复制这个文件为 .env，填入真实值，然后本地测试时用
#   pip install python-dotenv
# 并在 main.py 开头加两行：
#   from dotenv import load_dotenv
#   load_dotenv()
#
# ⚠️ 真正部署到GitHub Actions时，不要把 .env 或真实密码提交到仓库！
# 而是去 GitHub仓库 Settings > Secrets and variables > Actions
# 里逐个添加同名的 Secret，工作流会自动读取（见 job_search.yml）。
# 记得把 .env 加进 .gitignore，避免手滑提交。
# ============================================================

# --- 发送汇总邮件用的SMTP（比如你的Gmail）---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-account@gmail.com
SMTP_PASSWORD=your-gmail-app-password
RECIPIENT_EMAIL=your-daily-email@example.com

# --- 读取Job Alert邮件用的IMAP（建议单独新开一个邮箱专门订阅）---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-dedicated-jobalert-inbox@gmail.com
IMAP_PASSWORD=your-gmail-app-password
